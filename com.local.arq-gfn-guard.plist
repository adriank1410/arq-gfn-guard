<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.arq-gfn-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ARQ_GFN_SCRIPT__</string>
  </array>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ARQ_GFN_NOTIFICATIONS</key>
    <string>0</string>
    <key>ARQ_GFN_LANG</key>
    <string></string>
    <key>ARQ_GFN_LOOP_SECONDS</key>
    <string>2</string>
    <key>ARQ_GFN_SAFETY_SECONDS</key>
    <string>60</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__ARQ_GFN_STDOUT__</string>
  <key>StandardErrorPath</key>
  <string>__ARQ_GFN_STDERR__</string>
</dict>
</plist>
